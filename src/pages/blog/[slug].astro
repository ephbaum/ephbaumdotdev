---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BlogPost from '@layouts/BlogPost.astro';
import { getPublishedPosts } from '@utils/posts';

export async function getStaticPaths() {
  const blogEntries = await getPublishedPosts();
  return blogEntries.map((blogpost) => ({
    params: { slug: blogpost.id },
    props: { blogpost },
  }));
}

interface Props {
  blogpost: CollectionEntry<'blog'>;
}

const { blogpost } = Astro.props;
const { Content, headings } = await render(blogpost);

// The content layer does not honour the `layout` frontmatter key that legacy
// collections applied automatically, so the layout is applied explicitly. It
// expects the frontmatter shape the markdown layout used to receive, which
// printed the publication date exactly as authored.
const content = { ...blogpost.data, pubDate: blogpost.data.pubDateRaw };
---

<BlogPost content={content} headings={headings}>
  <Content />
</BlogPost>
