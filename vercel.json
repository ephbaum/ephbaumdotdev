{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "installCommand": "rm -rf node_modules && pnpm install --frozen-lockfile",
  "devCommand": "pnpm run dev",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ephbaum.dev"
        }
      ],
      "destination": "https://ephbaum.dev/$1",
      "permanent": true
    }
  ]
}
