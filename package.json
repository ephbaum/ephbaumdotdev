  "packageManager": "pnpm@10.23.0",
  "author": {
    "name": "Eph Baum",
    "email": "eph_baum@outlook.com",
    "url": "https://ephbaum.dev/"
  },
  "homepage": "https://ephbaum.dev/",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "new:post": "node scripts/new-post.js",
    "quotes:check": "node scripts/straight-quotes.js --check",
    "quotes:fix": "node scripts/straight-quotes.js",
    "astro:check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check && pnpm run lint && pnpm run format:check && pnpm run quotes:check",
    "check:fix": "pnpm run quotes:fix && astro check && pnpm run lint:fix && pnpm run format"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
