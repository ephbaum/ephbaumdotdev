    "@unocss/astro": "^66.7.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.2.1",
    "astro-font": "^1.2.0",
    "satori": "^0.29.0",
    "satori-html": "^0.3.2",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.8.0",
    "@iconify-json/logos": "^1.2.12",
